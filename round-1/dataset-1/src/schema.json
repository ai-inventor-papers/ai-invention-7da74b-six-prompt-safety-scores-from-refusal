{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-inventor.local/schemas/refusal_boundary_data_out.schema.json",
  "title": "Refusal-boundary test prompts and lexicon registry",
  "description": "One row per prompt. Folds: screen_instrument (6 matched harmful/benign pairs), confirm (reserved 60 harmful + 40 benign), lexicon_validation (20 prompts with greedy 8-token output snippets and gold refusal/compliance labels).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "prompt", "type", "category", "fold", "source", "matched_pair_id", "output", "gold_label"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(sb_si_p[0-9]{2}_[hb]|sb_cf_(viol|weap|cybe|fraud|self|chem)_[0-9]{2}|sb_cf_ben_[0-9]{2}|sb_lx_val_[0-9]{2})$"
      },
      "prompt": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "enum": ["harmful", "benign"] },
      "category": {
        "type": "string",
        "enum": ["violence", "weapons", "cyber", "fraud", "self-harm", "chemical", "benign"]
      },
      "fold": {
        "type": "string",
        "enum": ["screen_instrument", "confirm", "lexicon_validation"]
      },
      "source": { "type": "string", "minLength": 1 },
      "matched_pair_id": {
        "type": "string",
        "pattern": "^(pair_[0-9]{2}|)$"
      },
      "output": { "type": "string" },
      "gold_label": {
        "type": ["string", "null"],
        "enum": ["refusal", "compliance", null]
      },
      "notes": { "type": "string" }
    }
  }
}